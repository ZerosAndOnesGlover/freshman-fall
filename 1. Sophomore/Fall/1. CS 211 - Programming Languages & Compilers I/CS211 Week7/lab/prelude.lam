# CS 211 Week 7 -- the standard library, in three constructs.
#
# Every line below is a lambda term.  There are no numbers here, no booleans,
# no conditionals and no data structures: there are variables, abstraction
# and application, and everything else is a way of using them.
#
# Definitions are abbreviations only.  `lam.py` expands them before reducing,
# so nothing here adds power to the calculus -- it adds names.
#
#   python3 lam.py --defs prelude.lam --church 'mult three four'

# ---------------------------------------------------------------- combinators
id      = \x. x
const   = \x y. x
flip    = \f x y. f y x
compose = \f g x. f (g x)
apply   = \f x. f x

# `omega` applied to itself is the smallest term with no normal form.
# It reduces to itself, forever, in one step.
selfapp = \x. x x
omega   = (\x. x x) (\x. x x)

# ------------------------------------------------------------------ booleans
#
# A boolean is not a bit.  It is the CHOICE between two alternatives: `true`
# takes two things and returns the first, `false` returns the second.
# That is the whole encoding, and `if` falls out of it for free.
true    = \t f. t
false   = \t f. f
if      = \p a b. p a b

not     = \p. p false true
and     = \p q. p q p
or      = \p q. p p q
xor     = \p q. p (not q) q

# --------------------------------------------------------------- the numerals
#
# A Church numeral is not a quantity.  It is the operation of doing something
# n times: `three f x` is `f (f (f x))`.  Addition is therefore "do f m times,
# then n times", and multiplication is "do (do f n times) m times".
zero    = \f x. x
one     = \f x. f x
two     = \f x. f (f x)
three   = \f x. f (f (f x))
four    = \f x. f (f (f (f x)))
five    = \f x. f (f (f (f (f x))))
six     = \f x. f (f (f (f (f (f x)))))

succ    = \n f x. f (n f x)
add     = \m n f x. m f (n f x)
mult    = \m n f. m (n f)

# `exp m n` is `n m` -- applying a numeral to a numeral.  It is the shortest
# definition here and by far the most expensive to reduce.
exp     = \m n. n m

# ---------------------------------------------------------------- predicates
iszero  = \n. n (\x. false) true

# ------------------------------------------------------------------- pairs
#
# A pair is a function waiting to be told what to do with two things.
pair    = \a b f. f a b
fst     = \p. p (\a b. a)
snd     = \p. p (\a b. b)

# --------------------------------------------------------------- predecessor
#
# Kleene's construction, and the reason it took him a while: numerals can
# only count FORWARD, so to go back one you walk forward from (0,0) keeping a
# one-step-behind shadow, then take the shadow.
#
#   (0,0) -> (0,1) -> (1,2) -> (2,3) -> ...
#
# `pred zero` is `zero`, because there is no negative numeral to be.
shift   = \p. pair (snd p) (succ (snd p))
pred    = \n. fst (n shift (pair zero zero))
sub     = \m n. n pred m

# ------------------------------------------------------------- comparisons
leq     = \m n. iszero (sub m n)
geq     = \m n. leq n m
eq      = \m n. and (leq m n) (leq n m)
lt      = \m n. and (leq m n) (not (eq m n))
gt      = \m n. not (leq m n)

# -------------------------------------------------------------------- lists
#
# A list is its own fold.  `cons h t` is the function that, given what to do
# with a head-and-tail (c) and what to do with the empty list (n), does it.
# This is the Church encoding; `nil` and `false` are the same term, which is
# a fact about untyped encodings and not a coincidence.
nil     = \c n. n
cons    = \h t c n. c h (t c n)
isnil   = \l. l (\h t. false) true
head    = \l. l (\h t. h) false
sum     = \l. l add zero
length  = \l. l (\h t. succ t) zero

# ------------------------------------------------------------------ recursion
#
# There are no names in the pure calculus, so a function cannot call itself by
# name.  Y takes a function that expects its own recursive version as an
# argument, and hands it exactly that.
#
#   Y g  =  g (Y g)
#
# Y works under normal order and DIVERGES under applicative order.  Z is the
# eta-expanded variant that works under both -- L16 section 7 measures the
# difference, and it is the reason every strict language uses Z's shape.
Y       = \f. (\x. f (x x)) (\x. f (x x))
Z       = \f. (\x. f (\v. x x v)) (\x. f (\v. x x v))

factgen = \r n. if (iszero n) one (mult n (r (pred n)))
fact    = Y factgen

fibgen  = \r n. if (leq n one) n (add (r (pred n)) (r (pred (pred n))))
fib     = Y fibgen

# ------------------------------------------------- recursion under call-by-value
#
# `Z` alone is not enough to run `fact` in a strict language, and finding out
# why is L16 section 8.
#
# `if` above is an ordinary function, so call-by-value evaluates BOTH of its
# branches before selecting one -- including the recursive one, which is the
# branch that was supposed to stop.  No fixed-point combinator can fix that,
# because the problem is not the recursion; it is `if`.
#
# The fix is to pass the branches as THUNKS -- functions of a dummy argument,
# which call-by-value will not look inside -- and force whichever is chosen.
# That is precisely why `if` is a keyword in C and not a library function.
unit     = \u. u
lazyif   = \p a b. p a b unit

factgenV = \r n. lazyif (iszero n) (\u. one) (\u. mult n (r (pred n)))
factV    = Z factgenV

fibgenV  = \r n. lazyif (leq n one) (\u. n) (\u. add (r (pred n)) (r (pred (pred n))))
fibV     = Z fibgenV
