diff --git a/kalloc.c b/kalloc.c
index 14cd4f4..3913365 100644
--- a/kalloc.c
+++ b/kalloc.c
@@ -94,3 +94,19 @@ kalloc(void)
   return (char*)r;
 }
 
+
+// Count the pages on the free list (CS 202 Week 5 measurement).
+int
+kfreecount(void)
+{
+  struct run *r;
+  int n = 0;
+
+  if(kmem.use_lock)
+    acquire(&kmem.lock);
+  for(r = kmem.freelist; r; r = r->next)
+    n++;
+  if(kmem.use_lock)
+    release(&kmem.lock);
+  return n;
+}
