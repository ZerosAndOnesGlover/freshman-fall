+// A small xorshift generator for the lottery. Called with ptable.lock held.
+static uint randstate = 2463534242;
+
+static uint
+nextrand(void)
+{
+  randstate ^= randstate << 13;
+  randstate ^= randstate >> 17;
+  randstate ^= randstate << 5;
+  return randstate;
+}
