+// Give the current process n tickets (Project 1). Returns -1 for n < 1.
+int
+settickets(int n)
+{
+  if(n < 1)
+    return -1;
+  acquire(&ptable.lock);
+  myproc()->tickets = n;
+  release(&ptable.lock);
+  return 0;
+}
+
+// Copy the process table's scheduling information out to the user (Project 1).
+int
+getpinfo(struct pstat *ps)
+{
+  struct proc *p;
+  int i = 0;
+
+  if(ps == 0)
+    return -1;
+  acquire(&ptable.lock);
+  for(p = ptable.proc; p < &ptable.proc[NPROC]; p++, i++){
+    ps->inuse[i] = p->state != UNUSED;
+    ps->pid[i] = p->pid;
+    ps->tickets[i] = p->tickets;
+    ps->ticks[i] = p->sched_ticks;
+  }
+  release(&ptable.lock);
+  return 0;
+}
