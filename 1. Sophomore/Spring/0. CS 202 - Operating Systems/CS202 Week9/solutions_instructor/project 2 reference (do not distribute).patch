+
+// Count the pages on the free list (CS 202 Week 5 measurement).
+int
+kfreecount(void)
+{
+  struct run *r;
+  int n = 0;
+
+  if(kmem.use_lock)
+    acquire(&kmem.lock);
+  for(r = kmem.freelist; r; r = r->next)
+    n++;
+  if(kmem.use_lock)
+    release(&kmem.lock);
+  return n;
+}
