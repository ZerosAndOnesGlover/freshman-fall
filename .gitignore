# ─── Obsidian ────────────────────────────────────────────────────────
# Editor state, settings and downloaded themes. The notes are the
# content; nothing under .obsidian/ is needed to read them, so the whole
# directory stays out of version control.
.obsidian/
.trash/

# ─── Claude Code ─────────────────────────────────────────────────────
# Machine-local settings plus the temp files written during saves.
.claude/

# ─── Python ──────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ─── Compiled C artifacts from lab starters ──────────────────────────
*.o
*.out
*.exe
a.out
# Preprocessor / assembler intermediates from `gcc -E` and `gcc -S`.
*.i
*.s
# Extensionless ELF binaries left in the PROG 101 week 0 folders (build
# output with no tracked sources).
/1. PROG 101/week0/lab0/buggy
/1. PROG 101/week0/lab0/hello
/1. PROG 101/week0/lab0/hello_full
/1. PROG 101/week0/lab0/temperature
/1. PROG 101/week0/ps0/fixed
/1. PROG 101/week0/ps0/greet
/1. PROG 101/week0/ps0/hello
/1. PROG 101/week0/ps0/info

# ─── Generated study site ────────────────────────────────────────────
# Rebuilt from the markdown by `python3 site/build.py` in a couple of
# seconds, so the output is not worth versioning. The generator itself,
# and the vendored KaTeX it needs to work offline, ARE tracked.
/_site/

# ─── OS noise ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Submissions ─────────────────────────────────────────────────────
# Each course under here gets its own git repo with its own remote
# (e.g. CS 101 -> ZerosAndOnesGlover/cs101). Tracking them from the
# vault repo would leave stray gitlinks pointing at commits this repo
# does not contain. Commit and push each course from inside its own
# directory instead.
/5. Academic Registry/4. Submissions/

# ─── Portal ──────────────────────────────────────────────────────────
# The student portal is its own project with its own git repo and its
# own remote (ZerosAndOnesGlover/portal). It reads the vault at runtime
# but is not vault content, and tracking it from here would leave a
# stray gitlink pointing at commits this repo does not contain. Commit
# and push it from inside "6. Portal" instead.
/6. Portal/

# ─── Practice ───────────────────────────────────────────────────────
practice/
