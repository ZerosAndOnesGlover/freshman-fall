# Lab data files (.csv and the like) are submitted work and are NOT
# ignored. Only files the analysis tools regenerate are ignored.

# Python bytecode
__pycache__/
*.py[cod]

# Virtual environments
venv/
.venv/
env/

# Notebook artifacts
.ipynb_checkpoints/

# Office lock files, written while a spreadsheet is open
~$*
.~lock.*#

# Editor files
tempCodeRunnerFile.py

# Per-week scratch space: classwork practice, test code, experiments.
# Never submitted. Listed last so it overrides the allow rules above.
practice/
